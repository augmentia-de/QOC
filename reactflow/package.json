{
  "name": "reactflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p core/tsconfig.json --noEmit",
    "build:app": "npm run typecheck && vite build",
    "build:core": "npm run typecheck:core && vite build -c core/vite.config.js",
    "build": "npm run build:app && npm run build:core",
    "build:qoc": "npm run build && node scripts/copy-to-quarkus.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@xyflow/react": "^13.0.1",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
