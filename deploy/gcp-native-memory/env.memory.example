# /etc/qoc/env Vorlage fuer den GCP-native Memory-Modus.
# Keine Datenbank, keine JDBC-URL, kein Flyway.
# Kopieren nach /etc/qoc/env und Werte anpassen.

# --- Engine Storage (komplett in-memory) ---
ENGINE_STORAGE=memory
ENGINE_RECOVERY_ENABLED=false

# --- Workflow: Definitionen als Dateien, Run-State im Heap ---
ENGINE_WORKFLOW_STORAGE=file
ENGINE_WORKFLOW_STORAGE_DIR=/data/wf
ENGINE_WORKFLOW_RECOVERY_ENABLED=false
ENGINE_WORKFLOW_MAX_STEPS=100
ENGINE_WORKFLOW_MAX_RESUME_ATTEMPTS=10

# --- Workspace / Home ---
ENGINE_WORKSPACE=/data/workspace
HOME=/data/home

# --- HTTP ---
QUARKUS_HTTP_PORT=8081

# --- Logging ---
LOG_DIR=/data/log

# --- Memory-Budget ---
ENGINE_MEMORY_MAX_BYTES=1073741824

# --- Security ---
# none | oidc
ENGINE_SECURITY_MODE=none
ENGINE_APPROVAL_BASE_URL=http://localhost:8082

# --- Datenbank deaktiviert ---
QUARKUS_DATASOURCE_JDBC_URL=
QUARKUS_FLYWAY_ENABLED=false

# --- Optional: Auth0/OIDC (nur wenn ENGINE_SECURITY_MODE=oidc) ---
# QUARKUS_OIDC_AUTH_SERVER_URL=https://dev-xxx.us.auth0.com
# QUARKUS_OIDC_TOKEN_ISSUER=https://dev-xxx.us.auth0.com/
# QUARKUS_OIDC_TOKEN_AUDIENCE=qoc-engine
# QUARKUS_HTTP_AUTH_PERMISSION_AUTHENTICATED_PATHS=/api/*,/mcp/*,/mcp
# QUARKUS_HTTP_AUTH_PERMISSION_AUTHENTICATED_POLICY=authenticated
