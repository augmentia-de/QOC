# Lokale AWS-Emulation (deploy/aws-ecs-minimal)
# Kopiere nach .env und fülle aus.

# Datenbank (Neon oder lokal)
ENGINE_DB_KIND=postgresql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/qoc
QUARKUS_DATASOURCE_USERNAME=qoc
QUARKUS_DATASOURCE_PASSWORD=change-me

# Auth-Modus: basic oder oidc
ENGINE_SECURITY_MODE=basic
OPENCODE_SERVER_PASSWORD=change-me-please

# Auth0 (nur wenn ENGINE_SECURITY_MODE=oidc)
QUARKUS_OIDC_AUTH_SERVER_URL=https://dev-1kxf4iy7txwbmdks.us.auth0.com/
QUARKUS_OIDC_TOKEN_ISSUER=https://dev-1kxf4iy7txwbmdks.us.auth0.com/
QUARKUS_OIDC_TOKEN_AUDIENCE=qoc-engine

# OpenAI / Provider
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
ENGINE_PROVIDER_URL=https://opencode.ai/zen/go/v1/chat/completions
OPENAI_MODEL=deepseek-v4.1-flash
ENGINE_MODEL_ID=deepseek-v4.1-flash

# Workspace / Home
ENGINE_WORKSPACE=/data/workspace
HOME=/data/home
LOG_DIR=/data/log

# Container
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8080
QUARKUS_OTEL_ENABLED=false
ENGINE_SHELL_SANDBOX_ENABLED=false
ENGINE_REVERT_SNAPSHOT=false
ENGINE_MAX_CONCURRENT_PROMPTS=4
ENGINE_TURN_MAX_WALL_MINUTES=10
