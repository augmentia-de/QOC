FROM debian:bookworm-slim
WORKDIR /work/
COPY quarkus/target/quarkus-1.0.0-SNAPSHOT-runner /work/application
COPY deploy/AGENTS.native.md /opt/qoc/AGENTS.md

RUN chmod 755 /work/application && mkdir -p /data/workspace /data/log /data/home/.opencode/plan \
    && apt-get update \
    && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 8080
ENV HOME=/data/home
ENV QUARKUS_HTTP_HOST=0.0.0.0
ENV QUARKUS_HTTP_PORT=8080
ENV ENGINE_DB_KIND=postgresql
ENV ENGINE_WORKSPACE=/data/workspace
ENV LOG_DIR=/data/log
ENV QUARKUS_OTEL_ENABLED=false
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /data/workspace /data/log /data/home/.opencode/plan && exec /work/application"]
