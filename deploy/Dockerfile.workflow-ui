# Multi-stage build for workflow-ui (React + Vite)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Upstream engine. The official nginx image renders /etc/nginx/templates/*.template
# with envsubst at container start, so the target can be changed without a rebuild.
ENV API_UPSTREAM=http://qoc-engine:8080
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
