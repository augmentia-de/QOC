# Gemeinsame Umgebung für alle QOC-Deployments (deploy/docker-compose.yml).
#
#   cp .env.example .env
#   # Werte eintragen, danach:
#   docker compose up -d qoc-local
#
# Varianten-Spezifisches (Ports, Workspace, Permissions, Profile) steht in
# deploy/docker-compose.yml. Hier stehen nur Werte, die für alle Varianten
# gleich sind. .env ist gitignored und darf Secrets enthalten.

# ---------------------------------------------------------------------------
# Host-Benutzer und Gruppen (Bind-Mounts, Testcontainers)
# ---------------------------------------------------------------------------
UID=1000
GID=1000
DOCKER_GID=983

# Workspace-Quelle auf dem Host für qoc-local/qoc-server/qoc-registry.
# Standard: ../data/workspace (relativ zu deploy/).
# QOC_WORKSPACE_HOST=/home/torsten/dev/my-projects/2oc/dws

# Skill-Bibliothek auf dem Host (read-only nach /data/skills/aisdlc).
# Standard: ../data/skills/aisdlc
# QOC_SKILLS_HOST=/home/torsten/dev/my-projects/AISDLC/.opencode/skills

# ---------------------------------------------------------------------------
# LLM-Provider
# ---------------------------------------------------------------------------
OPENAI_API_KEY=oc_sk_...
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
ENGINE_PROVIDER_URL=https://opencode.ai/zen/go/v1/chat/completions
OPENAI_MODEL=deepseek-v4.1-flash
ENGINE_MODEL_ID=deepseek-v4.1-flash
ENGINE_PROVIDER_SCRIPTED=false

# ---------------------------------------------------------------------------
# Datenbank (Postgres auf dem Host, Port 20000)
# ---------------------------------------------------------------------------
ENGINE_DB_KIND=postgresql
ENGINE_DB_DRIVER=org.postgresql.Driver
ENGINE_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:20000/qoc?sslmode=disable
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://host.docker.internal:20000/qoc?sslmode=disable
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=postgres
ENGINE_FLYWAY_LOCATIONS=classpath:db/migration
QUARKUS_FLYWAY_LOCATIONS=classpath:db/migration
SESSION_RETENTION_DAYS=14
ENGINE_AUDIT_RETENTION_DAYS=2

# SQLite-Alternative (nur für Einzelknoten/A2A):
# ENGINE_DB_KIND=sqlite
# ENGINE_DB_DRIVER=org.sqlite.JDBC
# ENGINE_DATASOURCE_URL=jdbc:sqlite:/data/qoc.db
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:sqlite:/data/qoc.db
# ENGINE_DB_PATH=/data/qoc.db
# ENGINE_FLYWAY_LOCATIONS=classpath:db/migration-sqlite
# QUARKUS_FLYWAY_LOCATIONS=classpath:db/migration-sqlite

# In-Memory-Alternative (Profil `memory` in docker-compose.yml):
# Wird dort gesetzt; die DataSource-URL wird explizit geleert.
# ENGINE_STORAGE=memory
# ENGINE_RECOVERY_ENABLED=false
# ENGINE_MEMORY_MAX_BYTES=1073741824

# ---------------------------------------------------------------------------
# Berechtigungen und Budgets
# ---------------------------------------------------------------------------
# Gilt für alle Varianten, außer wo docker-compose.yml explizit überschreibt.
ENGINE_PERMISSION_DEFAULT=least-privilege
ENGINE_PERMISSION_ASK_MODE=deny
ENGINE_QUESTION_TIMEOUT_SECONDS=300
ENGINE_QUESTION_AUTO_RETRY=false
ENGINE_QUESTION_MAX_RETRIES=1
ENGINE_MAX_CONCURRENT_PROMPTS=16
ENGINE_TURN_MAX_TOOL_CALLS=64
ENGINE_TURN_MAX_TOKENS=0
ENGINE_TURN_MAX_WALL_MINUTES=30
ENGINE_REVERT_SNAPSHOT=true
ENGINE_SETTINGS_WORKSPACE_ENABLED=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_DIR=/data/log
QUARKUS_LOG_FILE_ENABLED=true
QUARKUS_LOG_LEVEL=DEBUG
QUARKUS_LOG_CONSOLE_LEVEL=INFO
QUARKUS_LOG_FILE_LEVEL=DEBUG
ENGINE_LOG_JSON=true
QUARKUS_LOG_FILE_PATH=/data/log/qoc.log
ENGINE_LLM_LOG_ENABLED=true
ENGINE_LLM_LOG_PATH=/data/home/log/llm.log
ENGINE_LLM_LOG_LIMIT_BYTES=2097152
ENGINE_LLM_LOG_COUNT=20
QUARKUS_OTEL_ENABLED=false

# ---------------------------------------------------------------------------
# HTTP / Auth
# ---------------------------------------------------------------------------
QUARKUS_HTTP_HOST=0.0.0.0
# Basic-Auth-Passwort (leer = kein Basic Auth). Gilt für alle Varianten.
OPENCODE_SERVER_PASSWORD=
# OIDC wird für qoc-server, qoc-registry und qoc-minimal direkt gesetzt.
# Für qoc-local/qoc-dev: docker-compose.oidc.yml verwenden.

# ---------------------------------------------------------------------------
# Provider-Header einiger OpenAI-kompatibler Gateways
# ---------------------------------------------------------------------------
ENGINE_PROVIDER_SESSION_HEADER=sessionid
ENGINE_PROVIDER_SESSION_ID=qoc-default-session
ENGINE_PROVIDER_USER_AGENT=opencode-engine/1.0

# ---------------------------------------------------------------------------
# Web-Suche (Firecrawl)
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_ENDPOINT=https://mcp.firecrawl.dev/v2/mcp

# ---------------------------------------------------------------------------
# E-Mail-Tool (IMAP/SMTP) - leer lassen, um es zu deaktivieren
# ---------------------------------------------------------------------------
ENGINE_EMAIL_ENABLED=false
ENGINE_EMAIL_READ_ENABLED=false
ENGINE_EMAIL_ATTACHMENTS_ENABLED=false
ENGINE_EMAIL_ALLOWED_RECIPIENTS=
ENGINE_EMAIL_MAX_RECIPIENTS=10
ENGINE_EMAIL_MAX_ATTACHMENTS=5
ENGINE_EMAIL_MAX_ATTACHMENT_BYTES=10485760
ENGINE_EMAIL_MAX_BODY_CHARS=50000
ENGINE_EMAIL_MAX_SUBJECT_CHARS=200
ENGINE_EMAIL_MAX_PER_HOUR=20
ENGINE_EMAIL_IMAP_HOST=
ENGINE_EMAIL_IMAP_PORT=993
ENGINE_EMAIL_IMAP_SSL=true
ENGINE_EMAIL_IMAP_STARTTLS=true
ENGINE_EMAIL_IMAP_USER=
ENGINE_EMAIL_IMAP_PASSWORD=
ENGINE_EMAIL_SMTP_HOST=
ENGINE_EMAIL_SMTP_PORT=587
ENGINE_EMAIL_SMTP_STARTTLS=true
ENGINE_EMAIL_SMTP_USER=
ENGINE_EMAIL_SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Asynchrone Freigaben (E-Mail-HITL)
# ---------------------------------------------------------------------------
ENGINE_APPROVAL_ASYNC_ENABLED=false
ENGINE_APPROVAL_TIMEOUT_HOURS=72
ENGINE_APPROVAL_POLL_SECONDS=5
ENGINE_APPROVAL_BASE_URL=http://localhost:8080
ENGINE_APPROVAL_EMAIL_SMTP_HOST=
ENGINE_APPROVAL_EMAIL_SMTP_PORT=587
ENGINE_APPROVAL_EMAIL_USERNAME=
ENGINE_APPROVAL_EMAIL_PASSWORD=
ENGINE_APPROVAL_EMAIL_FROM=
ENGINE_APPROVAL_EMAIL_TO=
ENGINE_APPROVAL_EMAIL_STARTTLS=true

# ---------------------------------------------------------------------------
# A2A (Client) und Agent-Quelle
# ---------------------------------------------------------------------------
ENGINE_A2A_URLS=
ENGINE_AGENT_AUTHORING_ENABLED=true
ENGINE_AGENT_SOURCE_URL=
ENGINE_AGENT_SOURCE_TOKEN=

# Resilience (Phase 1)
ENGINE_PREFLIGHT_ENABLED=true
ENGINE_STEP_TIMEOUT_SECONDS=30
ENGINE_LOOP_DETECTION_THRESHOLD=5
ENGINE_PROVIDER_RETRY_MAX_ATTEMPTS=3
ENGINE_PROVIDER_RETRY_DELAY1_SECONDS=10
ENGINE_PROVIDER_RETRY_DELAY2_SECONDS=30

# Resilience (Phase 3-4)
ENGINE_TRIAGE_ENABLED=false
ENGINE_TRIAGE_MAX_ATTEMPTS=3
ENGINE_TRIAGE_MODEL=
ENGINE_WEBHOOK_ENABLED=false
ENGINE_WEBHOOK_URL=
ENGINE_WEBHOOK_FORMAT=generic
