# OIDC-Overlay für qoc-local / qoc-dev (lokales Keycloak).
#
#   cp .env.oidc.example .env.oidc
#   docker compose -f docker-compose.yml -f docker-compose.oidc.yml up -d qoc-local
#
# start-oidc.sh erledigt Keycloak-Start, Realm-Setup und den QOC-Start.

# --- OIDC-Resource-Server -------------------------------------------------
ENGINE_SECURITY_MODE=oidc
QUARKUS_OIDC_ENABLED=true

# Browser-facing issuer ist http://localhost:8180/realms/qoc.
# Der Container erreicht dasselbe Keycloak über host.docker.internal.
QUARKUS_OIDC_AUTH_SERVER_URL=http://host.docker.internal:8180/realms/qoc
QUARKUS_OIDC_TOKEN_ISSUER=http://localhost:8180/realms/qoc
QUARKUS_OIDC_JWKS_PATH=/protocol/openid-connect/certs
QUARKUS_OIDC_TOKEN_AUDIENCE=qoc-engine
QUARKUS_OIDC_CLIENT_ID=qoc-engine
QUARKUS_OIDC_CREDENTIALS_SECRET=qoc-engine-local-secret

# JSON-API und MCP schützen; die statische UI bleibt öffentlich, damit der
# Browser den Authorization-Code+PKCE-Flow starten kann.
QUARKUS_HTTP_AUTH_PERMISSION_AUTHENTICATED_PATHS=/api/*,/mcp/*,/mcp
QUARKUS_HTTP_AUTH_PERMISSION_AUTHENTICATED_POLICY=authenticated

# UI-Login (wird zusätzlich vom Overlay gesetzt).
ENGINE_UI_OIDC_ENABLED=true
ENGINE_UI_OIDC_ISSUER=http://localhost:8180/realms/qoc
ENGINE_UI_OIDC_CLIENT_ID=qoc-ui
ENGINE_UI_OIDC_AUDIENCE=qoc-engine
ENGINE_UI_OIDC_API_SCOPE=
