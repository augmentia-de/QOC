# Auth0 / OIDC configuration for the GCP VM native deployment.
#
# Copy to deploy/gcp-vm/gcp-auth0.env (gitignored) and adjust values, then run:
#   set -a; . deploy/gcp-vm/gcp-auth0.env; set +a
#   ./deploy/gcp-vm/gcp-auth0.sh check
#   ./deploy/gcp-vm/gcp-auth0.sh apply
#
# None of these values is a client secret. The QOC engine is a pure OIDC
# resource server and validates bearer tokens via Auth0 discovery/JWKS.

# --- target VM ------------------------------------------------------------
GCP_PROJECT=gen-lang-client-0960862878
GCP_ZONE=us-central1-a
GCP_VM=quad-e2micro
QOC_DOMAIN=test.augmentia.de
QOC_ENGINE_PORT=8081

# --- Auth0 ---------------------------------------------------------------
# Issuer with trailing slash (as returned by Auth0 discovery).
AUTH0_ISSUER=https://dev-1kxf4iy7txwbmdks.us.auth0.com/
AUTH0_CLIENT_ID=urr7kMsdGQgCu4PyOF5llxqNCUGjH1F2
AUTH0_AUDIENCE=qoc-engine
AUTH0_API_SCOPE=qoc:use
