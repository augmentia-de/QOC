# Copy to .env and adjust.

# === General / Server ===
# ENGINE_SESSION_TEMP_DIR=sessions  # Session temp directory
# ENGINE_SETTINGS_WORKSPACE_ENABLED=true  # Enable workspace-level settings
# ENGINE_STORAGE=postgres  # Storage backend (postgres/sqlite/memory)
# ENGINE_WORKSPACE=.  # Workspace directory
# LOG_DIR=./log  # Log directory

# === LLM / Provider ===
# ENGINE_LLM_LOG_COUNT=20
# ENGINE_LLM_LOG_ENABLED=true  # Dedicated LLM request/response trace: 2 MiB per file, 20 rotating files.
# ENGINE_LLM_LOG_LIMIT_BYTES=2097152
# ENGINE_LLM_LOG_PATH=./log/llm.log
# ENGINE_LLM_TRACE_FIRST_REQUEST_MAX=4000  # LLM trace display limits (chars) for the UI streaming
# ENGINE_LLM_TRACE_RESPONSE_MAX=800
# ENGINE_LLM_TRACE_SUBSEQUENT_REQUEST_MAX=800
# ENGINE_MODEL_CONTEXT_LIMIT=512000  # Model limits (context window and max output tokens)
# ENGINE_MODEL_ID=gpt-4o-mini  # Model ID
# ENGINE_MODEL_OUTPUT_LIMIT=128000
# ENGINE_MODEL_PROVIDER=openai  # Model provider (openai)
# ENGINE_PROVIDER_RETRY_MAX_ATTEMPTS=3  # Max retry attempts for provider calls
# ENGINE_PROVIDER_SCRIPTED=true  # Enable scripted provider
# ENGINE_PROVIDER_TYPE=http  # Provider type (http)
# ENGINE_PROVIDER_URL=https://api.openai.com/v1  # Provider chat completions URL
# ENGINE_TURN_MAX_TOKENS=0  # Cumulative turn token budget. 0 = no token limit.
# OPENAI_API_KEY=demo-key  # The key is read from the environment at runtime. The fallback only allows starting without a configured variable.

# === Database ===
# ENGINE_DB_DRIVER=  # JDBC driver class
# ENGINE_DB_KIND=postgresql  # Database kind (postgresql/sqlite)
# ENGINE_DB_PASSWORD=qoc  # Database password
# ENGINE_DB_PATH=./data/qoc.db  # SQLite database path
# ENGINE_DB_USER=qoc  # Database user
# ENGINE_STORAGE=postgres  # Storage backend (postgres/sqlite/memory)

# === Security / Auth ===
# ENGINE_PERMISSION_ASK_MODE=deny  # Permission ask-mode for headless/no-UI execution: allow | deny (default) | interactive
# ENGINE_PERMISSION_DEFAULT=least-privilege  # Permission default mode: least-privilege (deny all) or allow-all (OpenCode-compatible)
# ENGINE_SYSTEM_OWNERSHIP=system  # System ownership principal
# ENGINE_SYSTEM_ROLES=system  # System user roles
# ENGINE_SYSTEM_TOKEN=disabled  # Systemuser (service account) for background jobs and automation
# ENGINE_TOOL_TOKEN_ENABLED=false  # Security: tool-token issuance (short-lived, origin-bearing tokens for downstream tool calls)
# ENGINE_TOOL_TOKEN_SIGNING_KEY=disabled  # Tool token signing key
# ENGINE_TOOL_TOKEN_TTL_SECONDS=60  # Tool token TTL in seconds
# OPENCODE_SERVER_PASSWORD=  # HTTP Basic auth. Empty = off (loopback/trusted development only).
# QOC_OIDC_CLIENT_ID=  # QOC OIDC client ID
# QOC_OIDC_CLIENT_SECRET=  # QOC OIDC client secret
# QOC_OIDC_ISSUER=  # OIDC (Auth0) - configured via environment variables
# QUARKUS_OIDC_ENABLED=false  # Enable Quarkus OIDC
# QUARKUS_OIDC_TOKEN_AUDIENCE=qoc-engine  # OIDC token audience
# QUARKUS_OIDC_TOKEN_ISSUER=${QOC_OIDC_ISSUER:  # OIDC token issuer

# === Email ===
# ENGINE_EMAIL_ALLOWED_RECIPIENTS=  # Allowed email recipients
# ENGINE_EMAIL_ATTACHMENTS_ENABLED=false  # Enable email attachments
# ENGINE_EMAIL_ENABLED=true  # Email tool (IMAP/SMTP) guardrails
# ENGINE_EMAIL_IMAP_HOST=  # IMAP host
# ENGINE_EMAIL_IMAP_PASSWORD=  # IMAP password
# ENGINE_EMAIL_IMAP_PORT=993  # IMAP port
# ENGINE_EMAIL_IMAP_SSL=true  # IMAP SSL
# ENGINE_EMAIL_IMAP_STARTTLS=true  # IMAP STARTTLS
# ENGINE_EMAIL_IMAP_USER=  # IMAP user
# ENGINE_EMAIL_MAX_ATTACHMENTS=5  # Max attachments per email
# ENGINE_EMAIL_MAX_ATTACHMENT_BYTES=10485760  # Max attachment size in bytes
# ENGINE_EMAIL_MAX_BODY_CHARS=50000  # Max email body chars
# ENGINE_EMAIL_MAX_PER_HOUR=20  # Max emails per hour
# ENGINE_EMAIL_MAX_RECIPIENTS=10  # Max email recipients
# ENGINE_EMAIL_MAX_SUBJECT_CHARS=200  # Max email subject chars
# ENGINE_EMAIL_READ_ENABLED=true  # Enable email read
# ENGINE_EMAIL_SMTP_HOST=  # SMTP host
# ENGINE_EMAIL_SMTP_PASSWORD=  # SMTP password
# ENGINE_EMAIL_SMTP_PORT=587  # SMTP port
# ENGINE_EMAIL_SMTP_STARTTLS=true  # SMTP STARTTLS
# ENGINE_EMAIL_SMTP_USER=  # SMTP user

# === Async Approvals ===
# ENGINE_APPROVAL_ASYNC_ENABLED=false  # Async (durable) approvals
# ENGINE_APPROVAL_BASE_URL=http://localhost:8090  # Approval base URL
# ENGINE_APPROVAL_EMAIL_FROM=  # Approval email from address
# ENGINE_APPROVAL_EMAIL_PASSWORD=  # Approval email password
# ENGINE_APPROVAL_EMAIL_SMTP_HOST=  # Approval email SMTP host
# ENGINE_APPROVAL_EMAIL_SMTP_PORT=587  # Approval email SMTP port
# ENGINE_APPROVAL_EMAIL_STARTTLS=true  # Approval email STARTTLS
# ENGINE_APPROVAL_EMAIL_TO=  # Approval email to address
# ENGINE_APPROVAL_EMAIL_USERNAME=  # Approval email username
# ENGINE_APPROVAL_POLL_SECONDS=5  # Approval poll interval in seconds
# ENGINE_APPROVAL_TIMEOUT_HOURS=72  # Approval timeout in hours

# === Workflow Engine ===
# ENGINE_CONTEXT_DEFAULT_TASK=start  # Default user task (user message) for context agents. The system prompt is designed in the workflow; this is the generic trigger sent as the task.
# ENGINE_LOOP_DETECTION_THRESHOLD=5  # Loop detection threshold
# ENGINE_RECOVERY_ENABLED=true  # Enable recovery
# ENGINE_REVERT_SNAPSHOT=true  # Enable revert snapshot
# ENGINE_STEP_TIMEOUT_SECONDS=30  # Step timeout in seconds
# ENGINE_TRIAGE_ENABLED=false  # Resilience (Phase 3-4)
# ENGINE_TRIAGE_MAX_ATTEMPTS=3  # Triage max attempts
# ENGINE_TRIAGE_MODEL=  # Triage model
# ENGINE_WORKFLOW_MAX_RESUME_ATTEMPTS=10  # Max workflow resume attempts
# ENGINE_WORKFLOW_MAX_STEPS=100  # Max workflow steps (0 = unlimited)
# ENGINE_WORKFLOW_NODE_MAX_REPETITIONS=5  # Max node repetitions
# ENGINE_WORKFLOW_RECOVERY_ENABLED=true  # Enable workflow recovery
# ENGINE_WORKFLOW_STORAGE=auto  # Workflow runner storage auto | file | memory | postgres | sqlite auto follows engine.storage / engine.db.kind.
# ENGINE_WORKFLOW_STORAGE_DIR=./wf-data  # Workflow storage directory

# === Shell Sandbox ===
# ENGINE_SHELL_SANDBOX_BWRAP=bwrap  # Bubblewrap binary path
# ENGINE_SHELL_SANDBOX_ENABLED=true  # Shell sandbox (bwrap/bubblewrap). Enabled by default on Linux when bwrap is available; falls back to direct execution otherwise.
# ENGINE_SHELL_SANDBOX_ENV_ALLOWLIST=PATH,HOME,LANG,LC_ALL,LC_CTYPE,TMPDIR,TERM  # Sandbox env allowlist
# ENGINE_SHELL_SANDBOX_EXTRA_WRITABLE=  # Extra writable paths for sandbox
# ENGINE_SHELL_SANDBOX_GID=-1  # Sandbox GID
# ENGINE_SHELL_SANDBOX_MODE=workspace-write  # Shell sandbox mode
# ENGINE_SHELL_SANDBOX_UID=-1  # Sandbox UID

# === Preflight ===
# ENGINE_PREFLIGHT_DNS_ENABLED=true  # Enable preflight DNS check
# ENGINE_PREFLIGHT_ENABLED=true  # Resilience (Phase 1)
# ENGINE_PREFLIGHT_HTTP_CHECK_ENABLED=true  # Enable preflight HTTP check
# ENGINE_PREFLIGHT_TIMEOUT_SECONDS=5  # Preflight timeout in seconds
# ENGINE_PREFLIGHT_TTL_SECONDS=60  # Preflight TTL in seconds

# === Web Search (Firecrawl) ===
# FIRECRAWL_API_KEY=  # Firecrawl API key (optional, raises limits)
# FIRECRAWL_ENDPOINT=https://mcp.firecrawl.dev/v2/mcp  # Firecrawl MCP endpoint

# === Webhook ===
# ENGINE_WEBHOOK_ENABLED=false  # Enable webhook notifications
# ENGINE_WEBHOOK_FORMAT=generic  # Webhook format (generic)
# ENGINE_WEBHOOK_URL=none  # Webhook URL

# === Instructions / Memory ===
# ENGINE_INSTRUCTIONS_ENABLED=true  # Enable instructions
# ENGINE_MEMORY_MAX_BYTES=314572800  # In-memory mode: all storage ports use in-memory adapters. When engine.storage=memory, engine.db.kind is ignored.

# === MCP ===
# ENGINE_TEST_MCP_URL=  # Built-in test MCP server (TestServiceResource). Empty = auto (localhost:<port>/api/test/mcp)

# === Observability ===
# ENGINE_AUDIT_RETENTION_DAYS=2  # Audit log retention (events, tool output, snapshots) in days
# ENGINE_LOG_JSON=true  # Enable JSON logging
# GRAFANA_ENDPOINT=http://localhost:3000  # Dev-services observability endpoints (non-empty defaults satisfy the required config check).
# OTEL_COLLECTOR_URL=http://localhost:4317  # OTel collector URL
# OTEL_ENABLED=false  # OpenTelemetry tracing. Exporter endpoint configurable; disabled SDK keeps app runnable without collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OTel OTLP exporter endpoint
# OTEL_SERVICE_NAME=qoc-engine  # OTel service name
# OTEL_TRACES_ENABLED=false  # Enable OTel traces

# === Session ===
# ENGINE_QUESTION_AUTO_RETRY=false  # Auto-retry questions
# ENGINE_QUESTION_MAX_RETRIES=1  # Max question retries
# ENGINE_QUESTION_TIMEOUT_SECONDS=300  # Question tool timeout and auto-retry
# SESSION_RETENTION_DAYS=7  # Session retention in days

# === Workspace / Worktree ===
# ENGINE_WORKSPACE=.  # Workspace directory

# === Misc ===
# ENGINE_CONTEXT_DEFAULT_TASK=start  # Default user task (user message) for context agents. The system prompt is designed in the workflow; this is the generic trigger sent as the task.
# ENGINE_LLM_LOG_ENABLED=true  # Dedicated LLM request/response trace: 2 MiB per file, 20 rotating files.
